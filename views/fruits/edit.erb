<h2>Uppdatera frukt</h2>

<form action="/fruits/<%= @fruit['id']%>/update" method="post">
    <label>Frukt 
        <input type="text" name="fruit_name" value="<%= @fruit['name']%>">
    </label>
    <label>Beskrivning 
        <input type="text" name="fruit_description" value="<%= @fruit['description']%>">
    </label>
    <select name="category_id">
      <% @categories.each do |category| %>
        <% if category['id']==@fruit['category_id'] %>
            <option value="<%= category['id'] %>" selected><%= category['name'] %></option>
        <% else %>
            <option value="<%= category['id'] %>"><%= category['name'] %></option>
        <% end %>
      <% end %>
    </select>
    <input type="submit" value="Uppdatera">
</form>
