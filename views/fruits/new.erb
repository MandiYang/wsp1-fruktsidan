<h2>Ny frukt</h2>

<form action="/fruits" method="post">
   <label>Frukt <input type="text" name="fruit_name"></label>
   <label>Beskrivning <input type="text" name="fruit_description"></label>
   <label>Tastiness <input type="text" name="fruit_tastiness"></label>
   <label>Price <input type="text" name="fruit_price"></label>
   <select name="category_id">
      <% @categories.each do |category| %>
         <option value="<%= category['id'] %>"><%= category['name'] %></option>
      <% end %>
   </select>
   <input type="submit" value="Spara">
</form>
